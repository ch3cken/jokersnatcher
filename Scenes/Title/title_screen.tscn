[sub_resource type="Shader" id="TitleGradientShader"]
code = "shader_type canvas_item;
uniform vec4 apricot : source_color = vec4(1.0, 0.84, 0.53, 1.0);
uniform vec4 orange : source_color = vec4(0.93, 0.47, 0.19, 1.0);
varying float title_y;
varying float is_fill;
void vertex() {
    title_y = VERTEX.y;
    is_fill = step(0.9, COLOR.r);
}
void fragment() {
    vec3 gradient = mix(apricot.rgb, orange.rgb, smoothstep(24.0, 176.0, title_y));
    COLOR.rgb *= mix(vec3(1.0), gradient, is_fill);
}"

[sub_resource type="ShaderMaterial" id="TitleGradient"]
shader = SubResource("TitleGradientShader")
shader_parameter/apricot = Color(1, 0.84, 0.53, 1)
shader_parameter/orange = Color(0.93, 0.47, 0.19, 1)

